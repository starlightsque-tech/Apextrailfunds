generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  INVESTOR
  ADMIN
}

enum UserStatus {
  APPLICANT
  ACTIVE
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EntryType {
  SUBSCRIPTION
  WITHDRAWAL
  DISTRIBUTION
  FEE
  ADJUSTMENT
}

enum DocumentCategory {
  FACT_SHEET
  FINANCIAL_STATEMENT
  LEGAL
  TAX
  OTHER
}

enum DocumentVisibility {
  PUBLIC
  INVESTOR
  PRIVATE
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum SubscriptionStatus {
  REQUESTED
  INSTRUCTED
  SETTLED
  CANCELLED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  role          Role       @default(INVESTOR)
  status        UserStatus @default(APPLICANT)
  emailVerified Boolean    @default(false)
  emailOptOut   Boolean    @default(false)
  country       String?
  phone         String?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  application   Application?
  entries       LedgerEntry[]
  documents     Document[]     @relation("DocumentOwner")
  emails        EmailLog[]
  subscriptions SubscriptionRequest[]
  redemptions   RedemptionRequest[]
  auditEntries  AuditLog[]
}

model Application {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType      String
  country         String
  accredited      Boolean           @default(false)
  experience      String
  intendedAmount  Int
  referrer        String?
  notes           String?
  status          ApplicationStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  decisionNote    String?
  createdAt       DateTime          @default(now())
}

model LedgerEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  type      EntryType
  amount    Decimal   @db.Decimal(18, 2)
  units     Decimal?  @db.Decimal(18, 6)
  navPerUnit Decimal? @db.Decimal(18, 6)
  memo      String?
  createdBy String?
  createdAt DateTime  @default(now())

  @@index([userId, date])
}

model SubscriptionRequest {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  status     SubscriptionStatus @default(REQUESTED)
  note       String?
  adminNote  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([userId])
}

model RedemptionRequest {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  status    SubscriptionStatus @default(REQUESTED)
  note      String?
  adminNote String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId])
}

model Document {
  id         String             @id @default(cuid())
  title      String
  category   DocumentCategory
  visibility DocumentVisibility @default(PUBLIC)
  ownerId    String?
  owner      User?              @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedBy String?
  createdAt  DateTime           @default(now())

  @@index([visibility, category])
}

model EmailLog {
  id        String      @id @default(cuid())
  to        String
  subject   String
  template  String
  body      String?
  status    EmailStatus @default(QUEUED)
  error     String?
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([createdAt])
}

model PerformancePoint {
  id         String   @id @default(cuid())
  month      String   @unique // YYYY-MM
  netReturn  Float
  grossReturn Float?
  navPerUnit Float?
  aum        Float?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Setting {
  key      String   @id
  value    String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
