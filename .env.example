# ---- Required ----
# Postgres connection string (Render injects this from the database resource)
DATABASE_URL="postgresql://user:password@host:5432/apextrailfunds?schema=public"

# 32+ random characters. Signs session, verification and unsubscribe tokens.
# Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical origin used in emails and metadata (no trailing slash).
APP_URL="https://apextrailfunds.com"

# ---- Admin bootstrap (used by `npm run seed`) ----
ADMIN_EMAIL="you@apextrailfunds.com"
ADMIN_PASSWORD="choose-a-strong-password"

# ---- Email (Resend) ----
# Without a key, messages are retained in the admin outbox and nothing is sent.
RESEND_API_KEY=""
EMAIL_FROM="no-reply@apextrailfunds.com"

# ---- Live chat ----
NEXT_PUBLIC_TAWK_PROPERTY_ID="6af50a019d9ba43c443be7ac"
NEXT_PUBLIC_TAWK_WIDGET_ID="1k76iu5hr"
